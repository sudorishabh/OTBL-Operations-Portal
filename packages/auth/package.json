{
  "name": "@pkg/auth",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./permissions": {
      "import": "./dist/permissions.js",
      "require": "./dist/permissions.js",
      "types": "./dist/permissions.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
