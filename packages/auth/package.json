    "prebuild": "pnpm run clean"
  },
  "dependencies": {
    "@pkg/db": "workspace:*",
    "@pkg/utils": "workspace:*",
    "bcrypt": "^6.0.0",
    "better-auth": "1.7.27"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "typescript": "^5.0.0"
